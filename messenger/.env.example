APP_NAME=messenger
APP_DESCRIPTION=messenger-service
APP_VERSION=0.1.8

API_V1_PREFIX=/messenger/api/v1

POSTGRES_USER=messenger
POSTGRES_PASSWORD=messenger_password
POSTGRES_DB=messenger
POSTGRES_HOST=postgres_messenger
POSTGRES_PORT=5432
POSTGRES_ECHO=false

AUTH_GRPC_HOST=auth
AUTH_GRPC_PORT=50051
AUTH_GRPC_TLS_CA=/opt/app/certs/grpc/ca.pem

# Comma-separated list of allowed CORS origins (empty = no origins allowed)
CORS_ORIGINS=["https://example.com"]

# Logging level (debug, info, warning, error, critical)
LOG_LEVEL=info
